<Target Name="RemoveLatoFontFiles" AfterTargets="Build">
    <ItemGroup>
      <LatoFontFiles Include="$(OutputPath)LatoFont\**\*" />
    </ItemGroup>
    <Delete Files="@(LatoFontFiles)" ContinueOnError="true" />
    <RemoveDir Directories="$(OutputPath)LatoFont" ContinueOnError="true" />
  </Target>

  <Target Name="ExcludeLatoFontFromProject" BeforeTargets="PrepareForBuild;BeforeBuild">
    <ItemGroup>
      <Content Remove="@(Content)" Condition="'%(Content.Identity)' != '' and ($([System.String]::Copy('%(Content.Identity)').Contains('LatoFont')) or $([System.String]::Copy('%(Content.Identity)').Contains('latofont')))" />
      <None Remove="@(None)" Condition="'%(None.Identity)' != '' and ($([System.String]::Copy('%(None.Identity)').Contains('LatoFont')) or $([System.String]::Copy('%(None.Identity)').Contains('latofont')))" />
      <Compile Remove="@(Compile)" Condition="'%(Compile.Identity)' != '' and ($([System.String]::Copy('%(Compile.Identity)').Contains('LatoFont')) or $([System.String]::Copy('%(Compile.Identity)').Contains('latofont')))" />
      <EmbeddedResource Remove="@(EmbeddedResource)" Condition="'%(EmbeddedResource.Identity)' != '' and ($([System.String]::Copy('%(EmbeddedResource.Identity)').Contains('LatoFont')) or $([System.String]::Copy('%(EmbeddedResource.Identity)').Contains('latofont')))" />
    </ItemGroup>
  </Target>
  

  <Target Name="RemoveLatoFontContentFiles" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <_LatoFontContentFiles Include="@(ContentFilesFromPackages)" Condition="'%(ContentFilesFromPackages.Identity)' != '' and ($([System.String]::Copy('%(ContentFilesFromPackages.Identity)').Contains('LatoFont')) or $([System.String]::Copy('%(ContentFilesFromPackages.Identity)').Contains('latofont')))" />
    </ItemGroup>
    <ItemGroup>
      <ContentFilesFromPackages Remove="@(_LatoFontContentFiles)" />
    </ItemGroup>
  </Target>

